// Editor/resources/version.rc.in — TEMPLATE, configured by CMake into the build
// tree. Edit this file, never the generated copy: the version numbers below come
// from project(VERSION) in the root CMakeLists.txt, so the string a user reads
// in Explorer's Properties dialog, the string the launcher prints in its
// sidebar, and the version in CMakeLists.txt are the same value by construction.
//
// A hand-typed version here is exactly the bug this replaced: the launcher used
// to keep its own copy of the version as a .cpp literal with a "bump both
// together" comment, and went on advertising 0.1.0 through every build that
// nobody remembered to touch it in.
//
// Two resources live here and nowhere else:
//
//   ICON     The application icon. Before this the editor shipped with the
//            default blank application glyph, so the title bar, the taskbar and
//            Alt-Tab showed nothing that identified the program. The .ico is
//            GENERATED by make_icon.ps1 rather than hand-drawn: a binary logo in
//            the repository can only be changed with a hex editor, and a logo
//            nobody can change is a logo that goes stale. The script draws the
//            same cube-and-gizmo-origin mark the launcher draws (see
//            draw_vec_icon in Editor/src/ProjectLauncher.cpp), so the taskbar
//            and the in-app header are one product.
//
//   VERSIONINFO  File and product version. Explorer's Properties dialog reads
//            this, and so does anything that checks the binary's identity.

#include <winver.h>

// ICON_ID is 1 on purpose: it is the first (and only) icon in the exe, and
// LoadIcon(NULL, MAKEINTRESOURCE(1)) is the documented way to get "the
// application icon" without a class or a name string.
IDI_NOVAFORGE_ICON ICON DISCARDABLE "@SANAD_ICO@"

// FILEVERSION takes four 16-bit fields. CMake's version has three components
// (major.minor.patch[.tweak]), so the fourth is 0; the pre-release tag has no
// numeric field and lives in the string block below, which is where a human
// actually reads it. NF_VERSION_STRING is the composed "major.minor.patch-tag"
// the rest of the build uses, so this file and the launcher's sidebar cannot
// disagree about whether the build is a beta.
#define NF_FILEVER @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
#define NF_STRVER  "@NF_VERSION_STRING@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    NF_FILEVER
    PRODUCTVERSION NF_FILEVER
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0x0L
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = en-US, 04B0 = Unicode. The codepage MUST be 1200 for a Unicode
        // build; Explorer renders the tooltip as-is otherwise.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "SANAD"
            VALUE "FileDescription",  "SANAD Engine - Editor"
            VALUE "FileVersion",      NF_STRVER
            VALUE "InternalName",     "SANADEditor"
            // OriginalFilename is what Windows reports if a user drags the exe
            // into a support ticket. It names the file, not the product, so the
            // beta suffix stays out of it.
            VALUE "OriginalFilename", "SANADEditor.exe"
            VALUE "ProductName",      "SANAD Engine"
            VALUE "ProductVersion",   NF_STRVER
            // No LegalCopyright: there is no licence text to point at yet, and
            // an empty or invented one is worse than none.
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
